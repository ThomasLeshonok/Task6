# Copy to .env. On Streamlit Community Cloud put the same names in App settings > Secrets (TOML: NAME = "value").

# MySQL 8.0+ or MariaDB 10.4+ database that will hold the faker_ tables and procedures
# (python src/setup_db.py creates them). Local XAMPP: mysql://root@localhost:3306/faker
# Aiven: paste the Service URI, e.g. mysql://avnadmin:<password>@<host>:<port>/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://root@localhost:3306/faker

# TLS: DISABLED, REQUIRED (encrypted, certificate not checked), VERIFY_CA or VERIFY_IDENTITY.
# Empty = take ssl-mode from DATABASE_URL, otherwise DISABLED.
# DB_SSL_MODE=VERIFY_CA
# CA certificate for VERIFY_*: a file path or the PEM text itself (Aiven console > Overview > CA certificate).
# DB_SSL_CA=ca.pem

# Optional settings (defaults shown)
# DB_CHARSET=utf8mb4
# DB_DEFAULT_PORT=3306
# DB_CONNECT_TIMEOUT=10
# DB_POOL_SIZE=4
# Pooled connections idle longer than this are pinged (and reconnected) before use; fresher ones save a round trip.
# DB_PING_AFTER_SECONDS=30
# FAKER_BATCH_SIZE=10
# FAKER_DEFAULT_SEED=42
# FAKER_MAX_SEED=2147483647
# FAKER_ABOUT_SENTENCES=2
# FAKER_TEXT_PARAGRAPHS=3
# FAKER_TEXT_MAX_PARAGRAPHS=10
# FAKER_TEXT_SENTENCES=4
# FAKER_TEXT_MAX_SENTENCES=12
# FAKER_CACHE_ENTRIES=256
